# ---------------------------------------------------------------
# Opção A: Google AI Studio (mais simples, recomendado para aula)
# ---------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=cole_sua_chave_do_ai_studio_aqui

# ---------------------------------------------------------------
# Opção B: Vertex AI (necessária para o Memory Bank do lab 2b)
# ---------------------------------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=seu-projeto
# GOOGLE_CLOUD_LOCATION=us-central1
# AGENT_ENGINE_ID=

# Modelo usado em todos os labs
ARI_MODEL=gemini-2.5-flash

# Lab 03: API de status de rede da Aurora
AURORA_API_URL=http://localhost:8000

# Lab 04: MCP Toolbox
TOOLBOX_URL=http://localhost:5000

# ---------------------------------------------------------------
# Lab 07: agente de Retenção em Microsoft Agent Framework, via A2A
# ---------------------------------------------------------------
MAF_A2A_URL=http://localhost:9999
MAF_A2A_PORT=9999

# Só o servidor.py usa. O servidor_stub.py não lê nada disto.
# Em MAF 1.x o Azure OpenAI é acessado pelo Microsoft Foundry.
# FOUNDRY_PROJECT_ENDPOINT=https://<projeto>.services.ai.azure.com/api/projects/<nome>
# FOUNDRY_MODEL=gpt-4o-mini
